# worktree（每個改動一個，見 docs/agents/delivery.md）
.claude/worktrees/
.claude/settings.local.json

# 機密
.env
.env.*
!.env.example

# 雜項
.DS_Store

# 前端
node_modules/
dist/

# 第三方角色（CC BY-NC 4.0，不進版控，用 scripts/fetch_avatar.sh 下載）
public/avatars/*.glb

# 使用者自己的錄音（個人聲音，不進版控）
assets/audio/voice/

# 由 role_voices.py、clone_voice.py 產生的劇本（指向不進版控的錄音）
assets/scripts/*-voices.json
assets/scripts/*-clone.json

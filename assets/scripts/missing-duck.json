  "scenes": [
    {
      "id": "s1",
      "title": "The Gym",
      "lines": [
        {
          "id": "s1-l1",
          "speaker": "narrator",
          "text": "It was Friday morning at Green Hill Junior High. Tomorrow was the big basketball final, and the whole school was excited.",
          "emotion": "happy",
          "camera": {
            "view": "mid"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s1-l1.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l1.json"
        },
        {
          "id": "s1-l2",
          "speaker": "ben",
          "text": "Mia! Mia! Come quickly! Something terrible has happened!",
          "emotion": "fear",
          "gesture": {
            "name": "handup",
            "at": 0.2,
            "duration": 1.5
          },
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s1-l2.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l2.json"
        },
        {
          "id": "s1-l3",
          "speaker": "mia",
          "text": "Slow down, Ben. Take a deep breath. What's wrong?",
          "emotion": "neutral",
          "audio": "assets/audio/voice/missing-duck/lines/s1-l3.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l3.json"
        },
        {
          "id": "s1-l4",
          "speaker": "ben",
          "text": "The trophy is gone! The gold trophy in the glass case. It's not there anymore!",
          "emotion": "fear",
          "gesture": {
            "name": "side",
            "at": 1.0
          },
          "audio": "assets/audio/voice/missing-duck/lines/s1-l4.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l4.json"
        },
        {
          "id": "s1-l5",
          "speaker": "mia",
          "text": "Gone? But the final is tomorrow!",
          "emotion": "sad",
          "camera": {
            "view": "head"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s1-l5.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l5.json"
        },
        {
          "id": "s1-l6",
          "speaker": "narrator",
          "text": "The two friends ran down the hall to the gym. Coach Lee was standing in front of the empty glass case.",
          "emotion": "neutral",
          "camera": {
            "view": "mid"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s1-l6.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l6.json"
        },
        {
          "id": "s1-l7",
          "speaker": "coach-lee",
          "text": "I can't believe this! Who would steal our trophy? We won that trophy three years in a row!",
          "emotion": "angry",
          "gesture": {
            "name": "index",
            "at": 1.5
          },
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s1-l7.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l7.json"
        },
        {
          "id": "s1-l8",
          "speaker": "mia",
          "text": "Coach Lee, when did you last see it?",
          "emotion": "neutral",
          "audio": "assets/audio/voice/missing-duck/lines/s1-l8.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l8.json"
        },
        {
          "id": "s1-l9",
          "speaker": "coach-lee",
          "text": "Last night, at about six o'clock. I locked the gym door myself.",
          "emotion": "neutral",
          "audio": "assets/audio/voice/missing-duck/lines/s1-l9.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l9.json"
        },
        {
          "id": "s1-l10",
          "speaker": "mia",
          "text": "Was anything else missing?",
          "emotion": "neutral",
          "audio": "assets/audio/voice/missing-duck/lines/s1-l10.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l10.json"
        },
        {
          "id": "s1-l11",
          "speaker": "coach-lee",
          "text": "No. Only the trophy. And the door was still locked this morning.",
          "emotion": "sad",
          "gesture": {
            "name": "shrug",
            "at": 0.3
          },
          "audio": "assets/audio/voice/missing-duck/lines/s1-l11.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s1-l11.json"
        }
      ]
    },
    {
      "id": "s2",
      "title": "Looking for Clues",
      "lines": [
        {
          "id": "s2-l12",
          "speaker": "narrator",
          "text": "Mia looked carefully around the gym. She was quiet for a long time.",
          "emotion": "neutral",
          "camera": {
            "view": "mid"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s2-l12.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s2-l12.json"
        },
        {
          "id": "s2-l13",
          "speaker": "ben",
          "text": "What are you looking for?",
          "emotion": "neutral",
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s2-l13.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s2-l13.json"
        },
        {
          "id": "s2-l14",
          "speaker": "mia",
          "text": "Clues, Ben. A thief always leaves something behind.",
          "emotion": "neutral",
          "gesture": {
            "name": "index",
            "at": 0.3
          },
          "audio": "assets/audio/voice/missing-duck/lines/s2-l14.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s2-l14.json"
        },
        {
          "id": "s2-l15",
          "speaker": "narrator",
          "text": "Under the seats, Mia found three small things: a white feather, a few pieces of popcorn, and a wet footprint.",
          "emotion": "neutral",
          "audio": "assets/audio/voice/missing-duck/lines/s2-l15.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s2-l15.json"
        },
        {
          "id": "s2-l16",
          "speaker": "ben",
          "text": "A feather? Popcorn? That doesn't make any sense.",
          "emotion": "disgust",
          "gesture": {
            "name": "shrug",
            "at": 1.0
          },
          "audio": "assets/audio/voice/missing-duck/lines/s2-l16.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s2-l16.json"
        },
        {
          "id": "s2-l17",
          "speaker": "mia",
          "text": "Hmm. This footprint is very small. It's too small for an adult.",
          "emotion": "neutral",
          "camera": {
            "view": "head"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s2-l17.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s2-l17.json"
        },
        {
          "id": "s2-l18",
          "speaker": "ben",
          "text": "Maybe it was a ghost! People say the old gym is haunted!",
          "emotion": "fear",
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s2-l18.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s2-l18.json"
        },
        {
          "id": "s2-l19",
          "speaker": "mia",
          "text": "Ghosts don't eat popcorn, Ben.",
          "emotion": "happy",
          "audio": "assets/audio/voice/missing-duck/lines/s2-l19.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s2-l19.json"
        }
      ]
    },
    {
      "id": "s3",
      "title": "The Answer",
      "lines": [
        {
          "id": "s3-l20",
          "speaker": "narrator",
          "text": "Just then, they heard a strange sound from the storage room. Squeak. Squeak. Squeak.",
          "emotion": "fear",
          "camera": {
            "view": "mid"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l20.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l20.json"
        },
        {
          "id": "s3-l21",
          "speaker": "ben",
          "text": "Did you hear that? I'm not going in there!",
          "emotion": "fear",
          "gesture": {
            "name": "thumbdown",
            "at": 1.0
          },
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l21.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l21.json"
        },
        {
          "id": "s3-l22",
          "speaker": "mia",
          "text": "Then I'll go first. Stay behind me.",
          "emotion": "neutral",
          "gesture": {
            "name": "handup",
            "at": 0.8
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l22.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l22.json"
        },
        {
          "id": "s3-l23",
          "speaker": "narrator",
          "text": "Mia slowly opened the door. The room was dark. She turned on the light.",
          "emotion": "neutral",
          "audio": "assets/audio/voice/missing-duck/lines/s3-l23.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l23.json"
        },
        {
          "id": "s3-l24",
          "speaker": "mia",
          "text": "Ben! Coach! Come and look!",
          "emotion": "happy",
          "gesture": {
            "name": "handup",
            "at": 0.3
          },
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l24.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l24.json"
        },
        {
          "id": "s3-l25",
          "speaker": "narrator",
          "text": "Inside the storage room sat a little white duck. Next to the duck was the gold trophy, full of popcorn.",
          "emotion": "happy",
          "camera": {
            "view": "mid"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l25.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l25.json"
        },
        {
          "id": "s3-l26",
          "speaker": "coach-lee",
          "text": "A duck? How did a duck get into my gym?",
          "emotion": "neutral",
          "gesture": {
            "name": "shrug",
            "at": 0.5
          },
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l26.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l26.json"
        },
        {
          "id": "s3-l27",
          "speaker": "mia",
          "text": "Look, the window above the door is open. The duck came in from the pond last night. It was looking for food.",
          "emotion": "neutral",
          "gesture": {
            "name": "index",
            "at": 0.2
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l27.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l27.json"
        },
        {
          "id": "s3-l28",
          "speaker": "ben",
          "text": "And the trophy was the perfect bowl!",
          "emotion": "happy",
          "gesture": {
            "name": "thumbup",
            "at": 0.5
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l28.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l28.json"
        },
        {
          "id": "s3-l29",
          "speaker": "coach-lee",
          "text": "But who put the popcorn in the trophy?",
          "emotion": "neutral",
          "audio": "assets/audio/voice/missing-duck/lines/s3-l29.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l29.json"
        },
        {
          "id": "s3-l30",
          "speaker": "narrator",
          "text": "Everyone turned around. A small boy was standing at the door. It was Coach Lee's son, Sam.",
          "emotion": "neutral",
          "camera": {
            "view": "mid"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l30.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l30.json"
        },
        {
          "id": "s3-l31",
          "speaker": "sam",
          "text": "I'm sorry, Dad. The duck was so hungry. I just wanted to help it.",
          "emotion": "sad",
          "camera": {
            "view": "head"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l31.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l31.json"
        },
        {
          "id": "s3-l32",
          "speaker": "coach-lee",
          "text": "Oh, Sam. You should have asked me first. But you have a kind heart.",
          "emotion": "love",
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s3-l32.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s3-l32.json"
        }
      ]
    },
    {
      "id": "s4",
      "title": "The Final",
      "lines": [
        {
          "id": "s4-l33",
          "speaker": "narrator",
          "text": "The next day, the trophy was back in the glass case, shiny and clean. And the team had a new friend.",
          "emotion": "happy",
          "camera": {
            "view": "mid"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s4-l33.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s4-l33.json"
        },
        {
          "id": "s4-l34",
          "speaker": "ben",
          "text": "Ladies and gentlemen, please welcome... Lucky the Duck!",
          "emotion": "happy",
          "gesture": {
            "name": "handup",
            "at": 1.5
          },
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s4-l34.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s4-l34.json"
        },
        {
          "id": "s4-l35",
          "speaker": "mia",
          "text": "Sometimes the biggest mystery has the smallest answer.",
          "emotion": "love",
          "camera": {
            "view": "head"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s4-l35.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s4-l35.json"
        },
        {
          "id": "s4-l36",
          "speaker": "all",
          "text": "Thank you!",
          "emotion": "happy",
          "gesture": {
            "name": "namaste",
            "at": 0.1
          },
          "camera": {
            "view": "upper"
          },
          "audio": "assets/audio/voice/missing-duck/lines/s4-l36.wav",
          "timestamps": "assets/audio/voice/missing-duck/lines/s4-l36.json"
        }
      ]
    }
  ]
}
